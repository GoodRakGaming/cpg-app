# Git ignore patterns

# Backend
backend/node_modules/
backend/.env
backend/.env.local
backend/storage/pdfs/*.pdf

# Frontend
frontend/node_modules/
frontend/.env.local
frontend/.next/
frontend/out/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
Thumbs.db
.DS_Store

# Project artifacts
.turbo/
dist/
build/

# Old/historical docs — kept locally on the dev machine only, not pushed to
# GitHub or production. Active docs live directly in docs/ (README/STATUS/
# ARCHITECTURE/DEPLOYMENT) and docs/PLANNING/.
docs/ARCHIVES/
docs/BACKEND/
docs/FRONTEND/
docs/TESTING/
docs/TROUBLESHOOTING/
docs/GETTING_STARTED/
docs/ARCHITECTURE/
docs/_INDEX.md
