# Git ignore patterns

# Backend
backend/node_modules/
backend/.env
backend/.env.local
backend/storage/pdfs/*.pdf

# Frontend
frontend/node_modules/
frontend/.env.local
frontend/.next/
frontend/out/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
Thumbs.db
.DS_Store

# Project artifacts
.turbo/
dist/
build/
__pycache__/
*.pyc

# Internal planning/working docs and infra/deployment details — kept locally only, never
# pushed to GitHub. GitHub carries only what's needed to run and continue development
# (README/SETUP, docs/README, docs/ARCHITECTURE, docs/STATUS with infra specifics scrubbed).
# Real deployment topology, active planning notes, external review transcripts, and n8n
# workflow drafts all live here on disk for our own use, not in git history going forward.
docs/PLANNING/
docs/DEPLOYMENT.md

# Old/historical docs — kept locally on the dev machine only, not pushed to
# GitHub or production.
docs/ARCHIVES/
docs/BACKEND/
docs/FRONTEND/
docs/TESTING/
docs/TROUBLESHOOTING/
docs/GETTING_STARTED/
docs/ARCHITECTURE/
docs/_INDEX.md
