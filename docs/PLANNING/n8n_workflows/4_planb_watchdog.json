      ]
    },
    "List (processing/)": { "main": [[{ "node": "Loop Over Items ", "type": "main", "index": 0 }]] },
    "Loop Over Items ": { "main": [[{ "node": "GET ingest-runs/active", "type": "main", "index": 0 }]] },
    "GET ingest-runs/active": { "main": [[{ "node": "Классифицировать (D1/I3)", "type": "main", "index": 0 }]] },
    "Классифицировать (D1/I3)": { "main": [[{ "node": "Switch (verdict)", "type": "main", "index": 0 }]] },
    "Switch (verdict)": {
      "main": [
        [{ "node": "PATCH abandoned", "type": "main", "index": 0 }],
        [{ "node": "Move → archive/<дата>/", "type": "main", "index": 0 }],
        [{ "node": "Move → postponed/ (нет записи)", "type": "main", "index": 0 }]
      ]
    },
    "PATCH abandoned": { "main": [[{ "node": "Move → postponed/ (stale)", "type": "main", "index": 0 }]] },
    "Move → archive/<дата>/": { "main": [[{ "node": "PATCH completed", "type": "main", "index": 0 }]] },
    "Move → postponed/ (нет записи)": { "main": [[{ "node": "Telegram: запись не найдена", "type": "main", "index": 0 }]] }
  }
