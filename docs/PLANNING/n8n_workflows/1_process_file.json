          { "name": "row_text", "type": "string", "value": "=ЗАМЕНИ ЭТО ВЫРАЖЕНИЕ: собери текст строки из реальных полей после первого тестового запуска, например `Наименование: ${$json['Наименование работы']}. Ед. изм.: ${$json['Ед.изм']}. Цена: ${$json['Цена']} руб.`" },
          { "name": "source_type", "type": "string", "value": "=ЗАМЕНИ: 'supplier' или 'own' — подтверди/поправь после первого теста" },
          { "name": "source_detail", "type": "string", "value": "=ЗАМЕНИ: имя поставщика/источника (раунд 2, I5 — не хардкод)" }
        ] },
