      "parameters": {
        "rules": { "values": [
          { "outputKey": "create", "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "create", "operator": { "type": "string", "operation": "equals" } }] } },
          { "outputKey": "resume", "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "resume", "operator": { "type": "string", "operation": "equals" } }] } },
          { "outputKey": "race_exit", "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "race_exit", "operator": { "type": "string", "operation": "equals" } }] } }
        ] },
        "options": { "fallbackOutput": "none" }
      },
