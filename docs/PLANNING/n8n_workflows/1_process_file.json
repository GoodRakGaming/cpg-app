    },
    {
      "parameters": {
        "jsCode": "// 12. Финальный подсчёт по завершении цикла (все батчи пройдены).\nconst staticData = $getWorkflowStaticData('node');\nconst acc = staticData[$execution.id];\nconst errorSummary = acc.error_parts.slice(0, 20).join('\\n') + (acc.error_parts.length > 20 ? `\\n...и ещё ${acc.error_parts.length - 20}` : '');\nreturn [{ json: { rows_success: acc.rows_success, rows_failed: acc.rows_failed, failed_rows: acc.failed_rows, error_summary: errorSummary || null } }];"
