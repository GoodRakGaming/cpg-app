    {
      "parameters": {
        "jsCode": "// Раунд 4 (D3): source_row вычисляется ОДИН РАЗ, сразу после Extract, по позиции в СЫРОМ массиве —\n// до resume-фильтра и до Loop Over Items. Дальше это неизменное свойство item.\n// +2 = смещение на строку заголовка (одна строка заголовков — донастроить, если их больше).\nreturn items.map((item, i) => ({ json: { ...item.json, source_row: i + 2 } }));"
      },
      "id": "compute-source-row",
      "name": "Вычислить source_row (D3)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3080, 540]
    },
    {
      "parameters": {
        "jsCode": "// Раунд 4 (D3): resume-фильтр по абсолютному source_row. При action != 'resume' — пропустить всё как есть.\nconst decision = $('route-decision').item.json;\nif (decision.action !== 'resume') return items;\n\nconst rowsProcessed = decision.stale_rows_processed || 0;\nconst failedRows = new Set(decision.stale_failed_rows || []);\n\nreturn items.filter((item) => {\n  const row = item.json.source_row;\n  if (row > rowsProcessed) return true; // ещё не дошли в прошлый раз\n  return failedRows.has(row); // дошли, но эта строка упала — не теряем молча (раунд 4, E1/I2)\n});"
      },
      "id": "resume-filter",
      "name": "5. Resume-фильтр (D3/E1)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3300, 540]
    },
