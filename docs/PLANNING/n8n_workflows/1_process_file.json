    {
      "parameters": {
        "jsCode": "// 11. Heartbeat — конец итерации батча (раунд 4, I1: после ingest, не между Ollama и ingest; D3: max(source_row), не (итерация+1)×batch_size).\nconst batch = $json.batch_items.map((i) => i.json);\nconst maxSourceRow = Math.max(...batch.map((b) => b.source_row));\nconst failedThisBatch = batch.filter((b) => !b.ok).map((b) => b.source_row);\n\nconst staticData = $getWorkflowStaticData('node');\nconst acc = staticData[$execution.id];\nacc.rows_success += batch.filter((b) => b.ok).length;\nacc.rows_failed += failedThisBatch.length;\nacc.failed_rows.push(...failedThisBatch);\nbatch.filter((b) => !b.ok).forEach((b) => acc.error_parts.push(`строка ${b.source_row}: ${b.error}`));\n\nreturn [{ json: { rows_processed: maxSourceRow, failed_rows: acc.failed_rows } }];"
      },
