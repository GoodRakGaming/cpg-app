# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=proposals
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/proposals

# Server Configuration
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# PDF Configuration
PDF_STORAGE_PATH=./storage/pdfs

# API Configuration
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Puppeteer
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false

# Phase 10 — каталог цен
# API-ключ, которым n8n авторизуется при вызове POST /api/price-catalog/ingest (заголовок X-API-Key)
PRICE_CATALOG_INGEST_KEY=change-this-to-a-random-string
# Локальная LLM-инфраструктура (Ollama, LXC 107) — см. docs/PLANNING/PHASE_10_llm_infra_plan.md
OLLAMA_URL=http://192.168.1.106:11434
# Модель для Библиотекаря (категоризация при записи) — пусто = библиотекарь всегда fallback'ится.
# По итогам тестирования на реальных данных (2026-08-07, 5 раундов, 31 кейс) рекомендована
# devstral:24b — 0/31 ошибок, 0/8 на критичных over-merge кейсах, ~5.1s/вызов. Резервный вариант
# при равном качестве — phi4:14b, но почти вдвое медленнее (~9.3s/вызов). См. docs/PLANNING/
# PHASE_10_PRICE_CATALOG_PLAN.md.
OLLAMA_MODEL=devstral:24b
OLLAMA_TIMEOUT_MS=20000
